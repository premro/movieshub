{
  "version": 2,
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/server/movieshub_api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/server/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
